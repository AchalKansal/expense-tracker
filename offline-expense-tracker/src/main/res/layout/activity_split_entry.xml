<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splitRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="←"
            android:textAllCaps="false"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splitTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Split expense"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/splitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <EditText
                android:id="@+id/totalAmountInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_background"
                android:hint="Total amount"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <AutoCompleteTextView
                android:id="@+id/friendNameInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="Friend's name"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView
                android:id="@+id/paidByLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Who paid?"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/paidByGroup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/paidByMeRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/type_toggle_background"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Me"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/paidByFriendRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/type_toggle_background"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Friend"
                    android:textStyle="bold" />
            </RadioGroup>

            <TextView
                android:id="@+id/splitModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Split"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/splitModeGroup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/equalSplitRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/type_toggle_background"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Equal"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/customSplitRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/type_toggle_background"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Custom"
                    android:textStyle="bold" />
            </RadioGroup>

            <EditText
                android:id="@+id/myShareInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="Your share"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <EditText
                android:id="@+id/friendShareInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="Friend's share"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background" />

            <EditText
                android:id="@+id/noteInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="Description"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <Button
                android:id="@+id/dateButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/type_toggle_background"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/primary_button"
                android:text="Save split expense"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="50dp" />
</LinearLayout>
